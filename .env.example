# Copy this file to .env only for the live-agent stack. Never commit .env.
# Use a model-provider key issued to the computer/operator, never a personal
# Coding Plan key.
DASHSCOPE_API_KEY=

# Optional: a tested QwenPaw release/image can replace the default latest tag.
# QWENPAW_IMAGE=agentscope/qwenpaw:latest
# Website Basic Auth (override for a non-demo deployment).
WEB_AUTH_USER=OCTRA
WEB_AUTH_PASSWORD=OCTRAum
