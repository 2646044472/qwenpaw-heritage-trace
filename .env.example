# Copy this file to .env for a live deployment. Never commit .env.
# These settings are used by the API's direct Pawly requests to an
# OpenAI-compatible relay. Use the relay's /v1 base URL and an operator-issued
# key; never use a personal Coding Plan key.
QWENPAW_LLM_BASE_URL=
QWENPAW_LLM_API_KEY=
QWENPAW_LLM_MODEL=
QWENPAW_LLM_TIMEOUT_SECONDS=30

# QwenPaw itself may use a provider-specific variable. Set this only when the
# selected QwenPaw image documents it (for example DASHSCOPE_API_KEY).
DASHSCOPE_API_KEY=

# Optional: a tested QwenPaw release/image can replace the default latest tag.
# QWENPAW_IMAGE=agentscope/qwenpaw:latest
