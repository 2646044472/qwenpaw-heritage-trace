{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heritage-trace.example/contracts/frontend-result.v1.schema.json",
  "title": "Heritage Trace frontend_result v1",
  "type": "object",
  "required": ["schema_version", "case_id", "shop_name", "workflow", "summary", "asset_card", "claims", "review_queue", "sources", "publication"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "case_id": { "type": "string", "minLength": 1 },
    "shop_name": { "type": "string", "minLength": 1 },
    "workflow": {
      "type": "object",
      "required": ["status", "current_stage", "steps"],
      "properties": {
        "status": { "enum": ["needs_review", "finished", "completed_with_errors"] },
        "current_stage": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "object", "required": ["agent", "status", "label", "summary"], "properties": { "agent": { "type": "string" }, "status": { "enum": ["completed", "pending", "running", "failed"] }, "label": { "type": "string" }, "summary": { "type": "string" } } } }
      }
    },
    "summary": { "type": "object", "required": ["total_claims", "supported", "partially_supported", "unsupported", "unverifiable", "review_required"], "properties": { "total_claims": { "type": "integer", "minimum": 0 }, "supported": { "type": "integer", "minimum": 0 }, "partially_supported": { "type": "integer", "minimum": 0 }, "unsupported": { "type": "integer", "minimum": 0 }, "unverifiable": { "type": "integer", "minimum": 0 }, "review_required": { "type": "integer", "minimum": 0 }, "by_risk_flag": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } } } },
    "asset_card": { "type": "object", "required": ["basic_info", "products", "persons", "key_events", "operations"], "properties": { "basic_info": { "$ref": "#/$defs/assetEntries" }, "products": { "$ref": "#/$defs/assetEntries" }, "persons": { "$ref": "#/$defs/assetEntries" }, "key_events": { "$ref": "#/$defs/assetEntries" }, "operations": { "$ref": "#/$defs/assetEntries" } } },
    "claims": { "type": "array", "items": { "$ref": "#/$defs/claim" } },
    "review_queue": { "type": "array", "items": { "$ref": "#/$defs/reviewIssue" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "publication": { "type": "object", "required": ["status", "blocking_claim_ids", "safe_to_publish"], "properties": { "status": { "enum": ["needs_review", "ready", "blocked"] }, "blocking_claim_ids": { "type": "array", "items": { "type": "string" } }, "safe_to_publish": { "type": "boolean" } } }
  },
  "$defs": {
    "verificationStatus": { "enum": ["supported", "partially_supported", "unsupported", "unverifiable"] },
    "assetEntries": { "type": "array", "items": { "type": "object", "required": ["label", "value", "claim_id", "verification_status"], "properties": { "label": { "type": "string" }, "value": { "type": "string" }, "claim_id": { "type": "string" }, "verification_status": { "$ref": "#/$defs/verificationStatus" } } } },
    "claim": { "type": "object", "required": ["claim_id", "field", "label", "value", "verification_status", "verification_level", "risk_flags", "source_ids", "reason"], "properties": { "claim_id": { "type": "string" }, "field": { "type": "string" }, "label": { "type": "string" }, "value": { "type": "string" }, "verification_status": { "$ref": "#/$defs/verificationStatus" }, "verification_level": { "enum": ["source_evidence", "search_extract", "insufficient_evidence"] }, "risk_flags": { "type": "array", "items": { "enum": ["source_conflict", "time_context_loss", "citation_error", "insufficient_locator", "authorization_risk"] } }, "source_ids": { "type": "array", "items": { "type": "string" } }, "reason": { "type": "string" } } },
    "reviewIssue": { "type": "object", "required": ["issue_id", "claim_id", "severity", "type", "title", "description", "recommended_actions"], "properties": { "issue_id": { "type": "string" }, "claim_id": { "type": "string" }, "severity": { "enum": ["low", "medium", "high", "critical"] }, "type": { "type": "string" }, "title": { "type": "string" }, "description": { "type": "string" }, "recommended_actions": { "type": "array", "items": { "type": "string" } } } },
    "source": { "type": "object", "required": ["source_id", "title", "content_type", "verification_ceiling"], "properties": { "source_id": { "type": "string" }, "title": { "type": "string" }, "publisher": { "type": "string" }, "url": { "type": "string" }, "content_type": { "type": "string" }, "verification_ceiling": { "type": "string" } } }
  }
}
