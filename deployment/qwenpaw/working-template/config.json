{
  "agents": {
    "active_agent": "Heritage-Coordinator",
    "agent_order": ["Heritage-Coordinator", "Paw-Miner", "Paw-Archivist", "Paw-Verifier"],
    "profiles": {
      "Heritage-Coordinator": {"id": "Heritage-Coordinator", "name": "Heritage-Coordinator", "enabled": true, "workspace_dir": "/app/working/workspaces/Heritage-Coordinator"},
      "Paw-Miner": {"id": "Paw-Miner", "name": "Paw-Miner", "enabled": true, "workspace_dir": "/app/working/workspaces/Paw-Miner"},
      "Paw-Archivist": {"id": "Paw-Archivist", "name": "Paw-Archivist", "enabled": true, "workspace_dir": "/app/working/workspaces/Paw-Archivist"},
      "Paw-Verifier": {"id": "Paw-Verifier", "name": "Paw-Verifier", "enabled": true, "workspace_dir": "/app/working/workspaces/Paw-Verifier"}
    },
    "defaults": {"heartbeat": {"enabled": false}}
  },
  "channels": {},
  "mcp": {"clients": {}},
  "tools": {
    "builtin_tools": {
      "read_file": {"enabled": true},
      "write_file": {"enabled": true},
      "edit_file": {"enabled": true},
      "append_file": {"enabled": true},
      "grep_search": {"enabled": true},
      "glob_search": {"enabled": true},
      "web_search": {"enabled": true},
      "web_fetch": {"enabled": true},
      "view_image": {"enabled": true},
      "view_video": {"enabled": true}
    }
  },
  "security": {
    "sandbox_enabled": true,
    "allow_no_auth_hosts": ["127.0.0.1", "::1"],
    "trusted_proxies": [],
    "tool_guard": {
      "enabled": true,
      "denied_tools": [
        "execute_shell_command", "execute_python_code", "execute_query",
        "browser", "desktop_screenshot",
        "send_file_to_user", "list_agents", "chat_with_agent", "submit_to_agent",
        "check_agent_task", "spawn_subagent", "delegate_external_agent",
        "materialize_skill", "ast_search", "run_tool_batch", "set_user_timezone"
      ]
    },
    "file_guard": {
      "enabled": true,
      "sensitive_files": [
        "/app/working.secret/", "/root/.ssh/", "/root/.aws/", "/root/.gnupg/",
        "/etc/passwd", "/etc/shadow", "/var/run/docker.sock"
      ],
      "allow_preview_outside_workspace": false
    },
    "skill_scanner": {"mode": "block"}
  },
  "user_timezone": "Asia/Shanghai",
  "skill_paths": []
}
