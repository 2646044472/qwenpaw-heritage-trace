QWENPAW_DB_PATH=/var/lib/qwenpaw/qwenpaw.db
QWENPAW_HOST=127.0.0.1
QWENPAW_PORT=8000
QWENPAW_COOKIE_SECURE=0
QWENPAW_INITIAL_USER=bankey
QWENPAW_INITIAL_PASSWORD_HASH=replace-with-a-scrypt-password-hash
# Leave blank to keep AI drafting disabled. Values belong only in /etc/qwenpaw/qwenpaw.env (0600).
QWENPAW_LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
QWENPAW_LLM_API_KEY=replace-with-provider-key
QWENPAW_LLM_MODEL=choose-a-model-available-to-this-key
QWENPAW_LLM_TIMEOUT_SECONDS=30
