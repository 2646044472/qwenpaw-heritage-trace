# Runtime data and local credentials
.data/
*.db
*.sqlite
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Python and editor artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.vscode/
.sentry-native/

# QwenPaw deployment state and provider secrets
/deployment/qwenpaw/secrets/*
!/deployment/qwenpaw/secrets/.env.example
!/deployment/qwenpaw/secrets/.gitkeep
/deployment/qwenpaw/backups/*
!/deployment/qwenpaw/backups/.gitkeep

# Local bridge state and logs
*.log
.tencent_winpty_bridge.json
.tencent_winpty_bridge.log

# Operating-system files
.DS_Store
Thumbs.db
