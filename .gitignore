# Reference material is local-only and may contain archives, runtime snapshots, or credentials.
/reference/
/.review-docx4/

# Runtime data and local credentials
.data/
*.db
*.sqlite
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Python artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Node and Next.js artifacts
node_modules/
.next/
coverage/
*.tsbuildinfo

# QwenPaw live-runtime state and provider secrets
/deployment/qwenpaw/secrets/*
!/deployment/qwenpaw/secrets/.env.example
!/deployment/qwenpaw/secrets/.gitkeep
/deployment/qwenpaw/backups/*
!/deployment/qwenpaw/backups/.gitkeep

# Local development artifacts
.vscode/
.vercel/
*.log
.DS_Store
Thumbs.db
