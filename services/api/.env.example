# Local Docker or peer-machine setup. Copy to .env and set the password hash locally.
# Do not put a QwenPaw Desktop/Coding Plan key in this file.
QWENPAW_INITIAL_USER=admin
QWENPAW_INITIAL_PASSWORD_HASH=replace-with-a-scrypt-password-hash
QWENPAW_LLM_BASE_URL=
QWENPAW_LLM_API_KEY=
QWENPAW_LLM_MODEL=
QWENPAW_LLM_TIMEOUT_SECONDS=30

# Workflow v2. Fixture mode is the safe, reproducible competition default.
# Set this to "real" only in a separately configured local QwenPaw environment.
QWENPAW_WORKFLOW_EXECUTOR=fixture
QWENPAW_BASE_URL=http://127.0.0.1:8088
QWENPAW_API_PREFIX=/api
QWENPAW_API_TOKEN=
QWENPAW_WORKFLOW_AGENT_TIMEOUT_SECONDS=360
QWENPAW_WORKFLOW_OVERALL_TIMEOUT_SECONDS=720
QWENPAW_API_RECONNECT_ATTEMPTS=1
# Optional; defaults to backend/.data/workflow-runtime.
QWENPAW_WORKFLOW_RUNTIME_ROOT=
# Explicit demo-only fallback: QWENPAW_WORKFLOW_EXECUTOR=fixture
